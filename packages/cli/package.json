{
  "name": "orka-agent",
  "version": "0.4.0",
  "description": "Orka in the terminal: the AI coding orchestrator of the VS Code extension, as a command-line app.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "terminal",
    "orchestrator",
    "supervisor",
    "llm",
    "claude",
    "openai",
    "gemini"
  ],
  "license": "MIT",
  "author": "Enophia Software",
  "homepage": "https://github.com/Enophia-Studio/orka#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enophia-Studio/orka.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Enophia-Studio/orka/issues"
  },
  "bin": {
    "orka": "dist/orka.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node esbuild.mjs && node --test \"test/*.test.mjs\"",
    "prepublishOnly": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@orka/core": "*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
